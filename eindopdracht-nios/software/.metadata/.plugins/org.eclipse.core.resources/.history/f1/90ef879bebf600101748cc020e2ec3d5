#include <stdio.h>
#include <system.h>                  // Voor alle BSP-definities (zoals base addresses en IRQs)
#include <altera_avalon_timer_regs.h> // Voor de timer-registerdefinities
//#include <sys/alt_irq.h>             // Voor de interrupt registratie functie (alt_ic_isr_register) [cite: 1648]
#include <io.h>
#include "includes.h"

// Register offsets
#define ADDR_CTRL 			0
#define ADDR_SPEED 			1
#define ADDR_STATUS 		2

#define TASK_STACKSIZE      2048
#define TASK_IO_TEST 		1

OS_STK    io_test[TASK_STACKSIZE];


void ms_lopen_counter_task(void* pdata)
{
  unsigned short current_count = 0;
  while (1)
  { 
    OSTimeDlyHMSM(0, 0, 0, 1);

    if (global_state == STILSTAAN) continue;

    ++current_count;
    IOWR_32DIRECT(REG32_AVALON_INTERFACE_0_BASE, 0, current_count);
  }
}

void seconds_lopen_counter_task(void* pdata)
{
  char current_count = 0;
  while (1)
  { 
    OSTimeDlyHMSM(0, 0, 1, 0);

    if (global_state == STILSTAAN) continue;

    ++current_count;
    IOWR_32DIRECT(REG32_AVALON_INTERFACE_0_BASE, 4, current_count);
  }
}

void input_task(void* pdata)
{
  char input_char;
  while (1)
  {
	  input_char = getchar();

	  if (input_char == '0')
	  {
		  global_state = STILSTAAN;
		  printf("'0' ontvangen STILSTAAN\n");
	  }
	  else if (input_char == '1')
	  {
		  global_state = LOPEN;
		  printf("'1' ontvangen LOPEN\n");
	  }
  }
}

int main(void)
{

  printf("Micrium\'s uC/OS-II is a real-time operating system (RTOS) available in source code.\n");

  OSTaskCreateExt(ms_lopen_counter_task,
                  NULL,
                  (void *)&ms_lopen_counter_task_stk[TASK_STACKSIZE-1],
                  ms_lopen_counter_task_PRIORITY,
                  ms_lopen_counter_task_PRIORITY,
                  ms_lopen_counter_task_stk,
                  TASK_STACKSIZE,
                  NULL,
                  0);
              
               
  OSTaskCreateExt(seconds_lopen_counter_task,
                  NULL,
                  (void *)&seconds_lopen_counter_task_stk[TASK_STACKSIZE-1],
                  seconds_lopen_counter_task_PRIORITY,
                  seconds_lopen_counter_task_PRIORITY,
                  seconds_lopen_counter_task_stk,
                  TASK_STACKSIZE,
                  NULL,
                  0);

  OSTaskCreateExt(input_task,
                  NULL,
                  (void *)&input_task_stk[TASK_STACKSIZE-1],
				  input_task_PRIORITY,
				  input_task_PRIORITY,
				  input_task_stk,
                  TASK_STACKSIZE,
                  NULL,
                  0);

  OSStart();
  return 0;
}

